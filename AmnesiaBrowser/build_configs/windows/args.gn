# Amnesia Browser Build Configuration - Windows

target_os = "win"
target_cpu = "x64"

is_component_build = false
is_debug = false
enable_nacl = false
use_aura = true
use_ozone = true
ozone_platform = "win"

# Security
enable_cpp_guard = true
enable_page_guard = true

# Amnesia-specific
enable_amnesia_browser = true
enable_session_manager = true
enable_fingerprint_generator = true
enable_ephemeral_storage = true
enable_cleanup_system = true
enable_tls_spoofing = true
enable_vless_integration = true
enable_geoip_spoofing = true
enable_pre_browsing_validation = true
enable_deterministic_noise = true

# Spoofing modules
enable_webrtc_spoofing = true
enable_webgl_spoofing = true
enable_canvas_spoofing = true
enable_audio_spoofing = true
enable_font_spoofing = true
enable_battery_spoofing = true
enable_screen_spoofing = true
enable_performance_spoofing = true
enable_storage_spoofing = true
enable_sensor_spoofing = true
enable_webusb_spoofing = true
enable_webbluetooth_spoofing = true
enable_webgpu_spoofing = true
enable_webmidi_spoofing = true

# Headers
enable_ua_spoofing = true
enable_sec_ch_spoofing = true
enable_http_headers_spoofing = true

# Network
enable_vless_collector = true
enable_xray_integration = true
enable_proxy_rotation = true
default_proxy_list_url = "https://raw.githubusercontent.com/26info/vless-proxy-list/main/working-proxies.txt"

# GeoIP
enable_geoip_spoofing = true
geoip_database_path = "resources\\geoip\\GeoLite2-City.mmdb"
geoip_asn_path = "resources\\geoip\\GeoLite2-ASN.mmdb"

# Consistency
enable_consistency_engine = true
enable_dag_rules = true
max_consistency_repair_attempts = 3
pre_browsing_validation_timeout_ms = 5000

# Session
session_seed_bits = 128
session_ttl_seconds = 0
session_storage_path = "C:\\Temp\\amnesia_sessions"
session_cleanup_on_shutdown = true
session_zeroize_memory = true

# UI
enable_amnesia_ui = true
show_initialization_screen = true
initialization_timeout_seconds = 90

include = "src\\amnesia.gni"
